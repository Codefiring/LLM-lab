def translate(dna: str, stop_at_stop: bool = True) -> str:
    """Translate DNA sequence to protein."""
    if not dna:
        return ""
    
    protein = []
    seq = dna.upper()
    
    for i in range(0, len(seq) - 2, 3):
        codon = seq[i:i+3]
        amino = DNA_CODON_TABLE.get(codon, 'X')
        
        if stop_at_stop and amino == '*':
